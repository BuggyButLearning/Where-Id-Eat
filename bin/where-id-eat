#!/usr/bin/env python3
import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
VALIDATE_DATA = ROOT / "validators" / "validate_data.py"
RENDER = ROOT / "renderer" / "render_report.py"
VALIDATE_HTML = ROOT / "validators" / "validate_html.py"


def run(*parts):
    cmd=[sys.executable, *map(str, parts)]
    result=subprocess.run(cmd)
    if result.returncode:
        raise SystemExit(result.returncode)


def main():
    ap=argparse.ArgumentParser(prog="where-id-eat", description="Validate and render a canonical Where I'd Eat report.")
    sub=ap.add_subparsers(dest="command", required=True)
    v=sub.add_parser("validate", help="validate report JSON")
    v.add_argument("input")
    r=sub.add_parser("render", help="validate report JSON, then render canonical HTML")
    r.add_argument("input"); r.add_argument("output")
    b=sub.add_parser("build", help="validate JSON, render HTML, then validate HTML")
    b.add_argument("input"); b.add_argument("output")
    args=ap.parse_args()
    if args.command=="validate":
        run(VALIDATE_DATA,args.input)
    elif args.command=="render":
        run(VALIDATE_DATA,args.input)
        run(RENDER,args.input,args.output)
    else:
        run(VALIDATE_DATA,args.input)
        run(RENDER,args.input,args.output)
        run(VALIDATE_HTML,args.output)
        print(f"Built canonical report: {args.output}")

if __name__=="__main__":
    main()
